{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/((?!api/|auth/).*)",
      "has": [
        {
          "type": "host",
          "value": "tatami-kg.vercel.app"
        }
      ],
      "destination": "https://apsatarov.vercel.app/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "fra1"
  ]
}
