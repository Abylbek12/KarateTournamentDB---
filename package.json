{
  "name": "apsatarov",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "theme:css": "node scripts/generate-theme-css.mjs",
    "predev": "npm run theme:css",
    "dev": "tsx server.ts",
    "start": "tsx server.ts --production",
    "prebuild": "npm run theme:css",
    "build": "vite build && npm run build:api",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/_server.mjs --log-level=warning",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:draw": "tsx scripts/test-draw.ts",
    "test": "npm run test:draw && npm run test:bouts && npm run test:categories && npm run test:intl && npm run test:youtube && npm run test:pricing && npm run test:athletes && npm run test:current && npm run test:sensei && npm run test:schedule && npm run test:workflow && npm run test:bracket && npm run test:organizer",
    "test:athletes": "tsx scripts/test-athletes.ts",
    "test:bouts": "tsx scripts/test-bouts.ts",
    "test:categories": "tsx scripts/test-categories.ts",
    "test:intl": "tsx scripts/test-intl.ts",
    "test:youtube": "tsx scripts/test-youtube.ts",
    "test:current": "tsx scripts/test-current-tournament.ts",
    "test:sensei": "tsx scripts/test-sensei.ts",
    "test:schedule": "tsx scripts/test-schedule.ts",
    "test:workflow": "tsx scripts/test-workflow.ts",
    "test:bracket": "tsx scripts/test-bracket-layout.ts",
    "test:organizer": "tsx scripts/test-organizer.ts",
    "test:pricing": "tsx scripts/test-pricing.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@google/genai": "3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.11.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
