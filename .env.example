# Copy this file to .env and fill in the values.

# Claude (Anthropic) API key for the «Сенсей» assistant. Without it the assistant is hidden.
ANTHROPIC_API_KEY=
# Бесплатная альтернатива для «Сенсея»: ключ из Google AI Studio (aistudio.google.com). Используется, если ANTHROPIC_API_KEY пуст.
# На бесплатном уровне Google может использовать вопросы для улучшения своих продуктов; дневной лимит небольшой.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Claude model (default: claude-opus-5-5)
CLAUDE_MODEL=

# Administrator account created on first start (REQUIRED in production).
# In development, if empty, admin@localhost is created and its password is printed in the server log.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Where tournaments, accounts, sessions and uploaded images are stored (default: ./data).
DATA_DIR=""

# HTTP port (default: 3000)
PORT=""

# Google / Facebook sign-in is not implemented yet (needs a server-side code exchange).
GOOGLE_CLIENT_ID=""
FACEBOOK_APP_ID=""

# Vercel: Postgres connection (set automatically when you connect Neon in Vercel → Storage).
# When set, data is stored in the database instead of DATA_DIR. Leave empty on a laptop.
DATABASE_URL=
